CREATE TABLE warrantyEntity (
    id TEXT NOT NULL PRIMARY KEY,
    productName TEXT NOT NULL,
    store TEXT NOT NULL,
    category TEXT NOT NULL,
    purchaseDateLabel TEXT NOT NULL,
    warrantyStatusLabel TEXT NOT NULL,
    urgencyDays INTEGER,
    price REAL,
    shape TEXT NOT NULL,
    warrantyEndDateLabel TEXT
);

-- One row per warranty / replacement / return / service promise. kind and source
-- are stored as free TEXT and parsed leniently, so future policy types need no
-- schema change — unknown kinds surface as "Other" with the wording preserved.
CREATE TABLE policyEntity (
    id TEXT NOT NULL PRIMARY KEY,
    warrantyId TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    provider TEXT,
    durationDays INTEGER,
    endEpochDay INTEGER,
    endDateLabel TEXT,
    notes TEXT,
    source TEXT NOT NULL
);

selectAll:
SELECT * FROM warrantyEntity;

countAll:
SELECT COUNT(*) FROM warrantyEntity;

insertWarranty:
INSERT INTO warrantyEntity(id, productName, store, category, purchaseDateLabel, warrantyStatusLabel, urgencyDays, price, shape, warrantyEndDateLabel)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllPolicies:
SELECT * FROM policyEntity;

insertPolicy:
INSERT INTO policyEntity(id, warrantyId, kind, title, provider, durationDays, endEpochDay, endDateLabel, notes, source)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWarrantyById:
DELETE FROM warrantyEntity WHERE id = ?;

deletePoliciesForWarranty:
DELETE FROM policyEntity WHERE warrantyId = ?;
